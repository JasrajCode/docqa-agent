# Neon's pooled connection string (host contains "-pooler"), using the read-only
# docqa_agent_ro role from sql/readonly_role.sql. Never DocQA's main credentials.
DATABASE_URL=postgresql://docqa_agent_ro:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Used only to embed search queries.
OPENAI_API_KEY=sk-...

# Comma-separated DocQA user ids whose documents this server may read, e.g. the demo user.
DOCQA_SCOPE_USER_IDS=
